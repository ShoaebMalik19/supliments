# Postgres connection used by the app. On Supabase use the pooler (transaction mode).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=
# Server-only. Mints signed URLs for the private assets bucket; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Must be a PRIVATE bucket (public = false).
ASSETS_BUCKET=assets-private
# Server-only. AES-256-GCM key for integration credentials (key id v1): `openssl rand -base64 32`.
INTEGRATION_ENCRYPTION_KEY=
# Shopify public app (Partners dashboard). Callback: $NEXT_PUBLIC_SITE_URL/api/integrations/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Optional override; default: write_products,read_orders,write_merchant_managed_fulfillment_orders
SHOPIFY_SCOPES=
# Seed only: password for the demo Supabase accounts (min 10 chars). Never commit a real value.
SEED_DEMO_PASSWORD=
